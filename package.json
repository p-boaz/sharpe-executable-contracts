{
  "name": "sharpe-executable-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:expectations": "tsx scripts/check-expectations.ts",
    "test:expr": "tsx src/core/eval-expr.test.ts",
    "test:conditions": "tsx src/core/condition-exec.test.ts",
    "run": "tsx src/main.ts run",
    "demo": "tsx src/main.ts run --contract contracts/WesTex-VISA-credit-card-agreement.md --out out/demo",
    "determinism": "tsx src/main.ts determinism"
  },
  "dependencies": {
    "yaml": "^2.8.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
}
